# Copy this file to .env and fill in values. Never commit .env.
#   cp .env.example .env && chmod 600 .env

FNMUSIC_HOME=

# Sources: enable at least one (install.sh --sources musicdl,musicbox,lxmusic)
# musicdl: https://github.com/CharlesPikachu/musicdl
# musicbox: https://github.com/darknessomi/musicbox
# lxmusic: 洛雪音乐源（免登录解析：酷狗 kg / 网易 wy / 咪咕 mg，高音质直链）
FNMUSIC_MUSICDL_ENABLED=true
FNMUSIC_NETEASE_ENABLED=true
FNMUSIC_MUSICDL_URL=http://127.0.0.1:8768
FNMUSIC_MUSICBOX_URL=http://127.0.0.1:8770
FNMUSIC_ONLINE_SOURCES=MiguMusicClient,KuwoMusicClient

# 边听边存 / 下载：v1.9.1 起收敛为「下载范围 × 下载时机」两个正交维度。
#   下载范围 FNMUSIC_DOWNLOAD_SCOPE   = off | favorites | all
#                                      off=不自动下载；favorites=只下收藏的（推荐）；all=播过的全下
#   下载时机 FNMUSIC_DOWNLOAD_TRIGGER = favorite | favorite_play | play
#                                      favorite=收藏那刻下载；favorite_play=收藏时+播放已收藏补漏（推荐）；play=只要播放就下
#   旧变量 FNMUSIC_TEE_SAVE_ENABLED / FNMUSIC_TEE_FAVORITES_ONLY /
#   FNMUSIC_FAV_DL_ON_FAVORITE / FNMUSIC_FAV_DL_ON_PLAY 仍会被读取并在新变量缺失时自动推导，
#   升级无需改配置；新变量一旦写入即优先。
FNMUSIC_DOWNLOAD_SCOPE=favorites
FNMUSIC_DOWNLOAD_TRIGGER=favorite_play

# 落盘目录：留空=自动探测飞牛官方共享曲库目录（配置后以配置为准，
# 路径不可用（无法创建/不可写）自动回退默认）。
# ★ 曲库若在 rclone 云盘（fuse 挂载）上，compose 里对应存储池必须挂成 :rw，
#   否则容器内是 Read-only file system。嫌云盘慢可改指 /app/downloads（本地盘）。
FNMUSIC_TEE_SAVE_DIR=
# 滚动试听缓存首数（仅「下载范围=off」时生效，保留最新 N 首完整试听）
FNMUSIC_TEE_CACHE_MAX=2

# 在线曲目是否写入收藏 / 播放历史：full=写入（收藏即下载、播放即下载、
# 取消收藏即删除均依赖它）；off=不写入，手机端收藏列表恒为本地曲目。
FNMUSIC_ONLINE_HISTORY_MODE=off

# 取消收藏时删除对应音频 / 歌词 / 引用，保持曲库干净
FNMUSIC_FAV_DELETE_ON_UNFAV=true
# 下载并发数 / 单首下载超时（秒）/ 单首大小上限（字节，默认 300MB）
FNMUSIC_FAV_DL_CONCURRENCY=2
FNMUSIC_FAV_DL_TIMEOUT_S=240
FNMUSIC_FAV_DL_MAX_BYTES=314572800

# 洛雪音乐源 lxmusic（第三音源，宿主机端口 8772 -> 容器 8000）
FNMUSIC_LX_ENABLED=true
FNMUSIC_LX_URL=http://127.0.0.1:8772

# 喜马拉雅有声书 xmly（第四音源，宿主机端口 8774 -> 容器 8000）
# 一个歌单 = 一部小说 = 喜马拉雅的一个专辑；搜索框输入「小说 三体」触发
# VIP / 付费专辑需在管理页（http://<NAS_IP>:8799/admin）扫码登录
FNMUSIC_XMLY_ENABLED=true
FNMUSIC_XMLY_URL=http://127.0.0.1:8774

# Web 管理后台端口（核心代理提供，不走 docker compose）
FNMUSIC_ADMIN_PORT=8799
# tx 暂无播放解析链路，默认不启用；有限媒体探活不保证完整歌曲。
LX_SOURCES=kg,wy,mg,kw
LX_THIRD_PARTY=1
LX_SEARCH_TIMEOUT=12
LX_LIMIT_PER_SOURCE=20
FNMUSIC_DEPLOY_MODE=docker

# 代理部署模式（v1.8.4+）：host=沿用 systemd（默认/一键回退）；docker=容器化代理
# （由 docker-compose.yml 的 proxy 服务拉起，需 pid: host + /var/run 挂载，fail-closed 安全机制不变）。
# 设为 docker 后请改用 ./extend.sh 部署；还原用 ./restore.sh（保留 systemd unit 作回退）。
FNMUSIC_PROXY_MODE=host

# 每日推荐：默认采信音源原生推荐（网易每日推荐/榜单 + lxmusic 免登录榜单）。
# 大模型候选仅当网易音源未启用（FNMUSIC_NETEASE_ENABLED=false）且配置了以下
# OpenAI 兼容参数时才作为兜底启用；留空即完全禁用。
FNMUSIC_LLM_BASE_URL=
FNMUSIC_LLM_API_KEY=
FNMUSIC_LLM_MODEL=gpt-4o-mini

# Docker 构建源（docker 模式；v1.2.3+）
# 基础镜像：留空时安装自动探测（国内镜像优先直连绕开 daemon 加速器，官方源兜底）并缓存到此键；
# 也可手动指定可用镜像引用，例如 docker.m.daocloud.io/library/python:3.13-slim
FNMUSIC_BASE_IMAGE=
# 容器内 pip 源（默认清华，与宿主机模式一致）
FNMUSIC_PIP_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
# musicdl 镜像内 apt 源（默认清华；仅构建层内临时替换+失败自动回退官方源，不影响宿主机与最终镜像；
# 想强制官方源可设为 http://deb.debian.org）
FNMUSIC_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
# 可选：自动探测时的国内镜像候选列表（空格分隔，按序尝试）
FNMUSIC_DOCKER_MIRRORS=docker.1ms.run docker.m.daocloud.io docker.1panel.live hub.rat.dev

# 搜索结果排序（v55+）：把「有海报 + 高音质」的在线条目顶到第一屏
# 排序策略：cover_quality=海报优先；quality_cover=音质优先；off=关闭排序（保留补全）
FNMUSIC_SEARCH_RANK=cover_quality
# 是否补全搜索结果的海报与音质档（一次批量请求补齐，失败不报错）
FNMUSIC_SEARCH_ENRICH=true
# 只补第一屏条数（控制首屏等待预算）
FNMUSIC_SEARCH_ENRICH_LIMIT=30
# 聚合末尾等补全的上限（秒）
FNMUSIC_SEARCH_ENRICH_WAIT_S=1.5
# 首屏等「补全 + 重排」落定的上限（秒）
FNMUSIC_SEARCH_RANK_WAIT_S=1.5

# 综合搜索（歌单 / 小说）结果缓存（v1.9.0+）：只缓存「成功且有结果且无告警」的响应，
# 降级与空结果不缓存（避免一次偶发失败被缓存住）。命中即毫秒级返回。
FNMUSIC_SEARCH_CACHE_TTL=600
FNMUSIC_SEARCH_CACHE_MAX=200

# 多音源并发搜索的常规等待预算（秒）
FNMUSIC_SEARCH_TIMEOUT=15
# 音源结果排序权重（逗号分隔）
FNMUSIC_SOURCE_ORDER=netease,lx,musicdl

# 网易云取流直连快通道（v1.9.0+）：开启后直连解析，需把 musicbox-data 挂进代理拿 cookie
FNMUSIC_NETEASE_DIRECT=true
# 网易云音质档：lossless / exhigh / higher / standard
FNMUSIC_NETEASE_QUALITY=lossless
# 取流直链缓存时长（秒）
FNMUSIC_STREAM_URL_TTL=600

# 歌词（v1.9.0+）
# 歌词贴身：歌词始终跟随音频落盘到曲库同名 sidecar
FNMUSIC_LYRIC_PROMOTE=true
# 孤儿歌词清理：定期回收留在缓存目录、曲库已无对应音频的歌词
FNMUSIC_LYRIC_ORPHAN_GC=true

# 库维护（v1.9.0+）：下载 / 删除后主动触发官方扫库。
# 曲库在 rclone 云盘（fuse）上时不会产生 inotify 事件，必须靠它让新歌立刻可见。
FNMUSIC_AUTO_SCAN=true
# 曲库根目录，留空=自动探测
FNMUSIC_LIBRARY_DIR=
