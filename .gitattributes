# 统一换行符，避免 Windows 上 checkout 出 CRLF 导致 shell 脚本无法执行
* text=auto

*.py            text eol=lf
*.sh            text eol=lf
*.service       text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf
.env.example    text eol=lf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.mp3           binary
*.flac          binary
*.ico           binary
